# ─────────────────────────────────────────────────────────────────────────────
# JAY INTERIORS — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── CLOUDINARY (REQUIRED FOR IMAGE UPLOADS) ───────────────────────────────────
# Step 1: Sign up / Log in at https://cloudinary.com
# Step 2: Go to Settings → Upload → Upload Presets → "Add upload preset"
# Step 3: Set Signing Mode to "Unsigned"
# Step 4: Give it a name (e.g. jay_interiors_upload) and click Save
# Step 5: Copy your Cloud Name from the top of the Cloudinary dashboard

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=jay_interiors_upload

# ── ADMIN PANEL PASSWORD ───────────────────────────────────────────────────────
# The password to log in to /admin
# Default if not set: jay2024admin

NEXT_PUBLIC_ADMIN_PASSWORD=jay2024admin

# ── EMAILJS (REQUIRED FOR CONTACT FORM SUBMISSIONS) ──────────────────────────
# Step 1: Sign up / Log in at https://www.emailjs.com/
# Step 2: Add a new Email Service (e.g., Gmail) and copy the Service ID
# Step 3: Create an Email Template, design it, and copy the Template ID
# Step 4: Go to Account → API Keys and copy your Public Key

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
